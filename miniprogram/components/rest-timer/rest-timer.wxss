.timer-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #1A2232;
  border: 2rpx solid rgba(200, 255, 0, 0.5);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.55);
  z-index: 999;
}

.timer-progress-bg {
  width: 100%;
  height: 6rpx;
  background-color: rgba(255, 255, 255, 0.08);
}

.timer-progress-fill {
  height: 100%;
  background-color: #C8FF00;
  transition: width 0.3s linear;
}

.timer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.timer-left {
  display: flex;
  flex-direction: column;
}

.timer-label {
  font-size: 22rpx;
  color: #9AA4B2;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timer-clock {
  font-size: 46rpx;
  font-weight: 800;
  color: #C8FF00;
  line-height: 1.15;
  margin-top: 4rpx;
}

.timer-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.timer-btn {
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background-color: #252E42;
  color: #F3F6FA;
  font-size: 24rpx;
  font-weight: 600;
}

.timer-btn:active {
  opacity: 0.75;
}

.timer-skip {
  background-color: #C8FF00;
  color: #0E1117;
}
