.heatmap-card {
  background-color: #171C26;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.heatmap-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.heatmap-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #F3F6FA;
}

.heatmap-sub {
  display: block;
  font-size: 22rpx;
  color: #9AA4B2;
  margin-top: 4rpx;
}

.heatmap-body {
  display: flex;
  align-items: flex-start;
}

.weekday-axis {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  margin-right: 8rpx;
}

.axis-month-spacer {
  height: 34rpx;
  margin-bottom: 6rpx;
}

.axis-label {
  height: 22rpx;
  line-height: 22rpx;
  font-size: 18rpx;
  color: #7D8590;
  margin-bottom: 6rpx;
}

.heatmap-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
}

.weeks-row {
  display: inline-flex;
  flex-direction: row;
  padding-right: 8rpx;
}

.week-col {
  display: flex;
  flex-direction: column;
  margin-right: 6rpx;
}

.month-label {
  height: 34rpx;
  line-height: 34rpx;
  font-size: 18rpx;
  color: #9AA4B2;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: visible;
}

.day-cell {
  width: 22rpx;
  height: 22rpx;
  border-radius: 5rpx;
  margin-bottom: 6rpx;
  box-sizing: border-box;
}

/* GitHub 风格 5 档深色青绿阶梯 */
.level-future {
  background-color: transparent;
}

.level-0 {
  background-color: #21262D;
}

.level-1 {
  background-color: #0E4429;
}

.level-2 {
  background-color: #006D32;
}

.level-3 {
  background-color: #26A641;
}

.level-4 {
  background-color: #39D353;
  box-shadow: 0 0 8rpx rgba(57, 211, 83, 0.45);
}

.day-cell.is-today {
  border: 2rpx solid #C8FF00;
}

.day-cell.is-selected {
  transform: scale(1.16);
  border: 2rpx solid #FFFFFF;
}

.heatmap-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.legend-hint {
  font-size: 20rpx;
  color: #677282;
}

.legend-scale {
  display: flex;
  align-items: center;
}

.legend-text {
  font-size: 18rpx;
  color: #7D8590;
  margin: 0 6rpx;
}

.legend-cell {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  margin: 0 3rpx;
}

.detail-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background-color: #1E2533;
  border-radius: 16rpx;
}

.detail-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.detail-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #F3F6FA;
}

.detail-level {
  font-size: 22rpx;
  font-weight: 600;
  color: #9AA4B2;
}

.level-text-3,
.level-text-4 {
  color: #39D353;
}

.level-text-1,
.level-text-2 {
  color: #00E5A0;
}

.detail-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.detail-chip {
  font-size: 21rpx;
  color: #D2DAE6;
  background-color: rgba(255, 255, 255, 0.06);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}

.detail-empty {
  font-size: 22rpx;
  color: #677282;
}
