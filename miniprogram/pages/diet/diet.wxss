.dashboard-card {
  background: linear-gradient(155deg, #1B2332 0%, #141923 100%);
  border-color: rgba(0, 229, 160, 0.24);
}

.diet-badge {
  display: inline-block;
  font-size: 21rpx;
  font-weight: 700;
  color: #00E5A0;
}

.kcal-row {
  margin-top: 6rpx;
}

.kcal-val {
  font-size: 48rpx;
  font-weight: 800;
  color: #F3F6FA;
}

.kcal-target {
  font-size: 24rpx;
  color: #9AA4B2;
}

.switch-type-btn {
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background-color: #232B3C;
  font-size: 22rpx;
  font-weight: 600;
  color: #C8FF00;
}

.kcal-bar-track {
  margin-top: 18rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background-color: #252E3F;
  overflow: hidden;
}

.kcal-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #00E5A0 0%, #C8FF00 100%);
}

.macro-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.macro-name {
  font-size: 23rpx;
  color: #9AA4B2;
}

.macro-val {
  font-size: 23rpx;
  font-weight: 700;
  color: #F3F6FA;
}

.macro-track {
  margin-top: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background-color: #252E3F;
  overflow: hidden;
}

.macro-fill {
  height: 100%;
  border-radius: 999rpx;
}

.fill-protein {
  background-color: #C8FF00;
}

.fill-carbs {
  background-color: #38BDF8;
}

.fill-fat {
  background-color: #FFB020;
}

.meal-card {
  padding: 26rpx;
}

.meal-eaten {
  border-color: rgba(0, 229, 160, 0.38);
}

.meal-slot {
  font-size: 30rpx;
  font-weight: 800;
  color: #F3F6FA;
}

.meal-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9AA4B2;
}

.meal-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.swap-btn {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background-color: #1E2533;
  color: #CBD4E1;
  font-size: 22rpx;
  font-weight: 600;
}

.eat-btn {
  padding: 10rpx 22rpx;
  border-radius: 12rpx;
  background-color: rgba(200, 255, 0, 0.14);
  color: #C8FF00;
  font-size: 22rpx;
  font-weight: 700;
}

.eat-btn-done {
  background-color: #00E5A0;
  color: #0E1117;
}

.meal-name {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #C8FF00;
}

.macro-chips {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.m-chip {
  font-size: 21rpx;
  color: #D2DAE6;
  background-color: #1E2533;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.ingredients-box {
  margin-top: 18rpx;
  background-color: #12161F;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}

.ing-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ing-row:last-child {
  border-bottom: none;
}

.ing-name {
  font-size: 25rpx;
  color: #E2E8F0;
}

.ing-amount {
  font-size: 25rpx;
  font-weight: 700;
  color: #00E5A0;
}

.prep-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #7D8590;
  line-height: 1.5;
}
