.hero {
  padding: 16rpx 4rpx 32rpx;
}

.hero-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #C8FF00;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  color: #F3F6FA;
  line-height: 1.25;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #9AA4B2;
}

.slider-group {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #D2DAE6;
}

.field-value {
  font-size: 38rpx;
  font-weight: 800;
  color: #C8FF00;
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #9AA4B2;
}

.age-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.age-input-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background-color: #1E2533;
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
}

.age-input {
  width: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #F3F6FA;
}

.time-slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.time-picker {
  flex: 1;
}

.time-box {
  background-color: #1E2533;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  text-align: center;
}

.time-box-label {
  display: block;
  font-size: 22rpx;
  color: #9AA4B2;
}

.time-box-val {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #C8FF00;
}

.time-sep {
  font-size: 32rpx;
  color: #677282;
}

.slot-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #7D8590;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scene-item {
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background-color: #1E2533;
  border: 2rpx solid transparent;
}

.scene-active {
  border-color: #C8FF00;
  background-color: rgba(200, 255, 0, 0.08);
}

.scene-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #F3F6FA;
}

.scene-check {
  font-size: 22rpx;
  font-weight: 600;
  color: #9AA4B2;
}

.scene-active .scene-check {
  color: #C8FF00;
}

.scene-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9AA4B2;
}

.preview-card {
  border-color: rgba(0, 229, 160, 0.25);
}

.metrics-grid {
  display: flex;
  justify-content: space-between;
  background-color: #1E2533;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  margin-bottom: 16rpx;
}

.metric-item {
  flex: 1;
  text-align: center;
}

.metric-val {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #00E5A0;
}

.metric-label {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9AA4B2;
}

.stage-desc {
  display: block;
  font-size: 23rpx;
  color: #B4BECB;
}

.submit-btn {
  margin-top: 12rpx;
}
