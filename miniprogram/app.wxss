/* LeanFit 深色运动极简全局主题 (Dark Athletic Minimalism) */
page {
  --bg-page: #0E1117;
  --bg-card: #171C26;
  --bg-card-alt: #1E2533;
  --bg-elevated: #242C3D;
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-accent: rgba(200, 255, 0, 0.35);

  --accent: #C8FF00;
  --accent-dim: rgba(200, 255, 0, 0.14);
  --accent-secondary: #00E5A0;
  --warning: #FFB020;
  --danger: #FF5C5C;

  --text-primary: #F3F6FA;
  --text-secondary: #9AA4B2;
  --text-muted: #677282;

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, scroll-view, input, button, picker {
  box-sizing: border-box;
}

.page-container {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border-subtle);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-accent {
  background-color: var(--accent-dim);
  color: var(--accent);
}

.badge-muted {
  background-color: var(--bg-card-alt);
  color: var(--text-secondary);
}

.badge-success {
  background-color: rgba(0, 229, 160, 0.16);
  color: var(--accent-secondary);
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  background-color: var(--accent);
  color: #0E1117;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 18rpx;
  background-color: var(--bg-card-alt);
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: 1rpx solid var(--border-subtle);
}

.btn-secondary::after {
  border: none;
}

.mono {
  font-variant-numeric: tabular-nums;
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-accent {
  color: var(--accent);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-muted {
  color: var(--text-muted);
}
